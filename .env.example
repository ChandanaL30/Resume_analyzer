# ==============================================================================
# Cloud-Based Resume Analyzer - Environment Configuration
# ==============================================================================
# NOTE: AWS S3 is OPTIONAL. The application runs 100% locally in "Local Processing"
# mode without any AWS credentials or an internet connection.
#
# SECURITY WARNING:
# - NEVER commit real AWS credentials to GitHub or version control.
# - The .env file is excluded by .gitignore.
# ==============================================================================

# AWS Region (e.g. us-east-1, ap-south-1, eu-west-1)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Private Amazon S3 Bucket Name
# Ensure this bucket is private with 'Block all public access' enabled.
S3_BUCKET_NAME=your-private-resume-analyzer-bucket

# AWS Credentials (Optional - only required if not using IAM Role / AWS CLI profile)
# If running on an EC2 instance with an IAM Role or using ~/.aws/credentials,
# you can leave these blank as boto3 automatically uses the AWS credential provider chain.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=optional_temporary_session_token_if_using_sts
